# Copy to .env and fill in whichever providers you intend to use.
# .env is git-ignored; never commit real keys.
#
# The model registry (code/naming_game/registry.py) routes each model key to a
# provider. You only need keys for the providers whose models you actually run.

# OpenRouter -- multi-vendor router, covers every model used in the paper.
# Simplest option: one key reaches OpenAI, Anthropic, Mistral, Google, Qwen, Meta.
openrouterkey=sk-or-v1-...

# Direct provider keys (optional; only if you prefer first-party endpoints)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
HF_TOKEN=hf_...

# Local models via Ollama need no key -- just `ollama serve` on :11434.
